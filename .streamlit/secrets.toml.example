# MODELO — NÃO coloque valores reais aqui nem versione o secrets.toml real.
# Cole o conteúdo abaixo (com os valores preenchidos) no editor de Secrets do
# app no Streamlit Community Cloud (Settings → Secrets).
#
# Login nativo do Streamlit (st.login) com Google, restrito a @cerrados.org
# pela verificação de domínio feita no app.py.

[auth]
redirect_uri = "https://SEU-APP.streamlit.app/oauth2callback"
cookie_secret = "GERAR_UMA_STRING_ALEATORIA_LONGA"
client_id = "XXXXXXXX.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxxxxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Dados (RPPNs, polígonos, processos): moram no repositório PRIVADO
# instituto-cerrados-ic/plataforma-rppn-dados e são lidos/gravados pelo app em
# tempo de execução. Token FINE-GRAINED com permissão "Contents: Read and write"
# SOMENTE nesse repositório de dados. Sem este bloco, o app usa a pasta local
# dados/ (desenvolvimento) e, no Streamlit Cloud, as gravações se perdem.
[github]
token = "github_pat_xxxxxxxxxxxxxxxxxxxx"
repo_dados = "instituto-cerrados-ic/plataforma-rppn-dados"
branch = "main"
